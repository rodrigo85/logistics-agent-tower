# =============================================================================
# Logistics Agent Tower - environment configuration
# Copy to `.env` and adjust. Every key maps 1:1 to `logistics_tower.config.Settings`.
# Never commit the real `.env` file.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=logistics-agent-tower
ENV=development                  # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Database ----------------------------------------------------------------
# Leave empty to use the local SQLite file at data/logistics.db (auto-created and seeded).
# PostgreSQL example (docker compose up -d postgres):
#   DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics
DATABASE_URL=

# --- LLM providers (reserved for LLM-backed agents; see docs/ARCHITECTURE.md) --
LLM_PROVIDER=ollama              # ollama | gemini | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Google Cloud / Maps -----------------------------------------------------
GCP_PROJECT_ID=my-logistics-gcp-project
GCP_REGION=southamerica-east1
# Optional. When set, routes use Google Routes API v2 with live traffic; otherwise haversine fallback.
GOOGLE_MAPS_API_KEY=

# --- Distribution center (default: Itajaí - SC) ------------------------------
DEFAULT_CD_ID=CD-ITAJAI-SC01
MAX_WEIGHT_THRESHOLD_PERCENT=100.0
MAX_VOLUME_THRESHOLD_PERCENT=100.0

# --- Daily route model (one multi-stop route per refrigerated truck) ---------
MAX_STOPS_PER_VEHICLE=12
DOCK_START_TIME=05:00            # loading starts; departure = DOCK_START_TIME + LOADING_TIME_MINUTES
LOADING_TIME_MINUTES=60
UNLOADING_TIME_MINUTES=20        # service time per stop
LUNCH_BREAK_MINUTES=60
LUNCH_EARLIEST_TIME=11:30
MAX_SHIFT_HOURS=11.0
URBAN_SPEED_KMH=32.0             # fallback when Google Maps is not configured
ROAD_CIRCUITY_FACTOR=1.35

# --- Human-in-the-Loop gate --------------------------------------------------
# true bypasses the approval interrupt (useful for automated pipelines / demos).
HITL_AUTO_APPROVE=false

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
