# Logistics Control Tower Environment Settings
APP_NAME=logistics-agent-tower
ENV=development
LOG_LEVEL=INFO

# LLM Providers (ollama | gemini | openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Cloud / Vertex AI (optional for GCP deployment)
GOOGLE_API_KEY=
GCP_PROJECT_ID=my-logistics-gcp-project
GCP_REGION=southamerica-east1

# OpenAI (optional)
OPENAI_API_KEY=

# Distribution Center Settings
DEFAULT_CD_ID=CD-SP01-CAJAMAR
MAX_WEIGHT_THRESHOLD_PERCENT=90.0
MAX_VOLUME_THRESHOLD_PERCENT=90.0

# Human-in-the-Loop Gate
HITL_AUTO_APPROVE=false

# API Settings
API_PORT=8000
API_HOST=0.0.0.0
