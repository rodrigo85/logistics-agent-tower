# Normalize line endings: LF in the repository, native on checkout.
* text=auto eol=lf

# Windows launchers must keep CRLF so cmd.exe / PowerShell parse them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.db binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
